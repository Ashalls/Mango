<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for Electron apps using V8 JIT under hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Allow loading Claude Agent SDK / node-pty / native modules whose
       signatures were not produced by us. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Outbound network access (Mongo connections, GitHub auto-update,
       Claude Agent SDK telemetry). -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Required when spawning child processes (mongosh, mongodump,
       Claude SDK cli.js). -->
  <key>com.apple.security.inherit</key>
  <true/>
</dict>
</plist>
